# OMATrust Backend — Environment Variables
#
# The active chain determines the environment and chain-specific configuration:
#   omachain-testnet  → OMAChain Testnet (chain ID 66238)
#   omachain-mainnet  → OMAChain Mainnet (chain ID 6623)
#   omachain-devnet   → OMAChain DevNet  (chain ID 66239)

# Backend self-reference URL (used for SIWE challenge domain and cookie config)
OMATRUST_BACKEND_URL=http://localhost:3000
OMATRUST_DEBUG=false

# Session + SIWE
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be at least 32 characters. Must be unique per environment.
OMATRUST_SESSION_SECRET=replace-with-a-long-random-secret
OMATRUST_SESSION_TTL_HOURS=24
OMATRUST_SIWE_NONCE_TTL_MINUTES=10
OMATRUST_ALLOWED_SIWE_DOMAINS=app.omatrust.org,registry.omatrust.org,localhost:3000
OMATRUST_ALLOWED_CORS_ORIGINS=https://preview.app.omatrust.org,https://preview.registry.omatrust.org,http://localhost:3000
OMATRUST_BROWSER_CLIENT_ID=omatrust-browser

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PAID_PRICE_ID=price_replace_me

# Delegated EAS Submission — Signing Configuration
#
# The code checks THIRDWEB_SECRET_KEY + THIRDWEB_SERVER_WALLET_ADDRESS first.
# If both are set (non-empty), it uses the Thirdweb Server Wallet (no raw key needed).
# If either is empty, it falls back to EAS_DELEGATE_PRIVATE_KEY.
#
# Testnet/Mainnet: use Thirdweb Server Wallet (set both values below).
# Local dev/Preview: use EAS_DELEGATE_PRIVATE_KEY or ~/.ssh/local-attestation-key file.
THIRDWEB_SECRET_KEY=replace-with-thirdweb-secret
THIRDWEB_SERVER_WALLET_ADDRESS=0xYourServerWalletAddress
# EAS_DELEGATE_PRIVATE_KEY=0x...

# Relay / chain
OMATRUST_ACTIVE_CHAIN=omachain-testnet
# Premium RPC is the entitlement-limited endpoint used for paid-quality reads and managed backend flows.
OMATRUST_PREMIUM_RPC_URL=https://rpc.testnet.chain.oma3.org/
# Safety cap for proxied eth_getLogs block span on the premium endpoint.
OMATRUST_PREMIUM_RPC_MAX_LOG_RANGE=50000
OMATRUST_MAX_GAS_PER_TX=800000

# Sponsor policy
OMATRUST_FREE_ANNUAL_SPONSORED_WRITES=10
# Premium reads are counted only against the premium RPC path, not the public rate-limited path.
OMATRUST_FREE_ANNUAL_PREMIUM_READS=100
OMATRUST_PAID_ANNUAL_SPONSORED_WRITES=100
OMATRUST_PAID_ANNUAL_PREMIUM_READS=1000
# Allow all schemas since we are giving everyone write credits
OMATRUST_FREE_ALLOWED_SCHEMA_UIDS=*
OMATRUST_PAID_ALLOWED_SCHEMA_UIDS=*
OMATRUST_SUBJECT_SCOPED_SCHEMA_UIDS=0x53498ae8ae4928a8789e09663f44d6e3c77daeb703c3765aa184b958c3ca41be,0x56d1e74383cbcfb89e23b25f444a081951a5d2fa7876b159da082b8cbd967af8,0x807b38ce9aa23fdde4457de01db9c5e8d6ec7c8feebee242e52be70847b7b966
